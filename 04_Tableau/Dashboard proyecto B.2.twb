      <aliases enabled='yes' />
      <column caption='Number of Loans 2' datatype='real' name='[Calculation_0807346952093696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_loan] = 1 THEN [Calculation_1085521916084225] END) &#13;&#10;/ &#13;&#10;COUNTD([Calculation_1085521916084225])' />
      </column>
      <column caption='Number of Permanent Transfers 2' datatype='real' name='[Calculation_0807346952294401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_loan] = 0 THEN [Calculation_1085521916084225] END) &#13;&#10;/ &#13;&#10;COUNTD([Calculation_1085521916084225])' />
      </column>
      <column caption='Position Group' datatype='string' name='[Calculation_0885412570595328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [position] IN (&quot;Centre-Back&quot;, &quot;Left-Back&quot;, &quot;Right-Back&quot;, &quot;Defender&quot;) THEN &quot;Defender&quot;&#13;&#10;ELSEIF [position] IN (&quot;Defensive Midfield&quot;, &quot;Central Midfield&quot;, &quot;Attacking Midfield&quot;, &quot;Left Midfield&quot;, &quot;Right Midfield&quot;) THEN &quot;Midfielder&quot;&#13;&#10;ELSEIF [position] IN (&quot;Left Winger&quot;, &quot;Right Winger&quot;, &quot;Centre-Forward&quot;, &quot;Second Striker&quot;) THEN &quot;Forward&quot;&#13;&#10;ELSEIF [position] = &quot;Goalkeeper&quot; THEN &quot;Goalkeeper&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Transfer Type' datatype='string' name='[Calculation_0885412573077505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_loan] IN (1) THEN &quot;Loan&quot;&#13;&#10;ELSEIF [is_loan] IN (0) THEN &quot;Permanent&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Number of Loans' datatype='integer' name='[Calculation_0971997357608962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF {FIXED [Season],[Calculation_1085521916084225]:MAX([is_loan])} = 1 THEN [Calculation_1085521916084225] end)' />
      </column>
      <column caption='Total Transfer Spending' datatype='real' name='[Calculation_1085521915011072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [movement] = &quot;in&quot; THEN [fee] END)' />
      </column>
      <column caption='Transfer_Id' datatype='string' name='[Calculation_1085521916084225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([Season])+str([player_id])' />
      </column>
      <column caption='Number of Transfers' datatype='integer' name='[Calculation_1085521917886466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1085521916084225])' />
      </column>
      <column caption='Average Transfer Fee' datatype='real' name='[Calculation_1085521919172612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1085521915011072]/[Calculation_1085521917886466]' />
      </column>
      <column caption='Total Transfer Income' datatype='real' name='[Calculation_1332912063905792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [movement] = &quot;out&quot; THEN [fee] END)' />
      </column>
      <column caption='Net Spend' datatype='real' name='[Calculation_1332912064471041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1085521915011072]-[Calculation_1332912063905792]' />
      </column>
      <column caption='Top Spending Club' datatype='string' name='[Calculation_1332912065241090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF {FIXED [club] : [Calculation_1085521915011072]} = {FIXED : MAX({FIXED [club] : [Calculation_1085521915011072]})} THEN [club] END) }' />
      </column>
      <column caption='Top Selling Club' datatype='string' name='[Calculation_1332912068018179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF {FIXED [club] : [Calculation_1332912063905792]} = {FIXED : MAX({FIXED [club] : [Calculation_1332912063905792]})} THEN [club] END) }' />
      </column>
      <column caption='Average Age' datatype='real' name='[Calculation_1411253300412416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [Calculation_1085521916084225] : MAX([age])})' />
      </column>
      <column caption='Average Market Value' datatype='real' name='[Calculation_1411253301641217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [Calculation_1085521916084225] : MAX([market_value])})' />
      </column>
      <column caption='Most Expensive Player' datatype='string' name='[Calculation_1411253303291907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF {FIXED [Calculation_1085521916084225] : MAX([fee])} = {FIXED : MAX({FIXED [Calculation_1085521916084225] : MAX([fee])})} THEN [player_name] END) }' />
      </column>
      <column caption='Most Represented Nationality' datatype='string' name='[Calculation_1411253304909828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF { FIXED [nationality] : COUNTD([Calculation_1085521916084225]) } = &#13;&#10;       { FIXED : MAX({ FIXED [nationality] : COUNTD([Calculation_1085521916084225]) }) } &#13;&#10;    THEN [nationality] &#13;&#10;    END&#13;&#10;) }' />
      </column>
      <column caption='Spending Growth %' datatype='real' name='[Calculation_1480797784162304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;  { FIXED : SUM(IF YEAR([Season]) = 2025 AND [movement] = &quot;in&quot; THEN [fee] END) }&#13;&#10;  -&#13;&#10;  { FIXED : SUM(IF YEAR([Season]) = 2020 AND [movement] = &quot;in&quot; THEN [fee] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : SUM(IF YEAR([Season]) = 2020 AND [movement] = &quot;in&quot; THEN [fee] END) }' />
      </column>
      <column caption='Loan %' datatype='real' name='[Calculation_1480797786304513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0971997357608962]/[Calculation_1085521917886466]' />
      </column>
      <column caption='Average Transfer Fee Growth' datatype='real' name='[Calculation_1480797788082178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;  { FIXED : AVG(IF YEAR([Season]) = 2025 AND [movement] = &quot;in&quot; THEN [fee] END) }&#13;&#10;  -&#13;&#10;  { FIXED : AVG(IF YEAR([Season]) = 2020 AND [movement] = &quot;in&quot; THEN [fee] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : AVG(IF YEAR([Season]) = 2020 AND [movement] = &quot;in&quot; THEN [fee] END) }' />
      </column>
      <column caption='Average transfers Fee Growth 2' datatype='real' name='[Calculation_1480797789184003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;  { FIXED : AVG({ FIXED [Season], [Calculation_1085521916084225] : MAX(IF YEAR([Season]) = 2025 AND [movement] = &quot;in&quot; THEN [fee] END) }) }&#13;&#10;  -&#13;&#10;  { FIXED : AVG({ FIXED [Season], [Calculation_1085521916084225] : MAX(IF YEAR([Season]) = 2020 AND [movement] = &quot;in&quot; THEN [fee] END) }) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED : AVG({ FIXED [Season], [Calculation_1085521916084225] : MAX(IF YEAR([Season]) = 2020 AND [movement] = &quot;in&quot; THEN [fee] END) }) }' />
      </column>
      <column caption='Fastest Growing League' datatype='string' name='[Calculation_1480797789634564]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF { FIXED [League] : SUM([Calculation_1480797784162304]) } = &#13;&#10;       { FIXED : MAX({ FIXED [League] : SUM([Calculation_1480797784162304]) }) } &#13;&#10;    THEN [League] &#13;&#10;    END&#13;&#10;) }' />
      </column>
