              <calculation class='tableau' formula='IF [position] IN (&quot;Centre-Back&quot;, &quot;Left-Back&quot;, &quot;Right-Back&quot;, &quot;Defender&quot;) THEN &quot;Defender&quot;&#13;&#10;ELSEIF [position] IN (&quot;Defensive Midfield&quot;, &quot;Central Midfield&quot;, &quot;Attacking Midfield&quot;, &quot;Left Midfield&quot;, &quot;Right Midfield&quot;) THEN &quot;Midfielder&quot;&#13;&#10;ELSEIF [position] IN (&quot;Left Winger&quot;, &quot;Right Winger&quot;, &quot;Centre-Forward&quot;, &quot;Second Striker&quot;) THEN &quot;Forward&quot;&#13;&#10;ELSEIF [position] = &quot;Goalkeeper&quot; THEN &quot;Goalkeeper&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
